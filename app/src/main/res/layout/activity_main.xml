<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg_light"
    tools:context=".MainActivity">

    <!-- Top AppBar with Gradient Background -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="6dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/bg_toolbar_sunset"
            app:title="@string/app_name"
            app:subtitle="@string/app_subtitle"
            app:titleTextColor="@color/white"
            app:subtitleTextColor="#E0E0E0"
            app:menu="@menu/main_options_menu" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Page Loading Progress Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:visibility="gone"
        app:trackColor="#40FFFFFF"
        app:indicatorColor="@color/white" />

    <!-- Search & Web Navigation Control Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E4F6"
        app:cardBackgroundColor="@color/card_surface_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/text_dark"
                android:contentDescription="@string/desc_back" />

            <!-- Forward Button -->
            <ImageButton
                android:id="@+id/btn_forward"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_forward"
                app:tint="@color/text_dark"
                android:contentDescription="@string/desc_forward" />

            <!-- Refresh Button -->
            <ImageButton
                android:id="@+id/btn_refresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_dark"
                android:contentDescription="@string/desc_refresh" />

            <!-- Address / Search EditText -->
            <EditText
                android:id="@+id/et_url"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="none"
                android:background="@null"
                android:hint="@string/hint_enter_url"
                android:textColorHint="@color/text_subtle"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:paddingHorizontal="8dp"
                android:singleLine="true" />

            <!-- Clear URL Button -->
            <ImageButton
                android:id="@+id/btn_clear_url"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                app:tint="@color/text_subtle"
                android:visibility="gone"
                android:contentDescription="@string/desc_clear" />

            <!-- Go Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_go"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/sunset_primary"
                android:paddingHorizontal="12dp"
                app:cornerRadius="18dp" />

            <!-- Popup Menu Trigger Button -->
            <ImageButton
                android:id="@+id/btn_popup_menu"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more"
                app:tint="@color/text_dark"
                android:contentDescription="@string/desc_popup" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Bookmark Chips Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_google"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Google"
                android:textColor="@color/chip_google_text"
                app:chipBackgroundColor="@color/chip_google"
                app:chipIconVisible="false"
                app:strokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_wiki"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Wikipedia"
                android:textColor="@color/chip_wiki_text"
                app:chipBackgroundColor="@color/chip_wiki"
                app:chipIconVisible="false"
                app:strokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_android"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 Android"
                android:textColor="@color/chip_android_text"
                app:chipBackgroundColor="@color/chip_android"
                app:chipIconVisible="false"
                app:strokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_github"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💻 GitHub"
                android:textColor="@color/chip_github_text"
                app:chipBackgroundColor="@color/chip_github"
                app:chipIconVisible="false"
                app:strokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_kotlin"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Kotlin"
                android:textColor="@color/chip_kotlin_text"
                app:chipBackgroundColor="@color/chip_kotlin"
                app:chipIconVisible="false"
                app:strokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_news"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📰 Tech News"
                android:textColor="@color/chip_news_text"
                app:chipBackgroundColor="@color/chip_news"
                app:chipIconVisible="false"
                app:strokeWidth="0dp" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Main Container for WebView and Error View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <!-- WebView Component -->
        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error / Offline Fallback View -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/app_bg_light"
            android:padding="24dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_web"
                        app:tint="@color/sunset_primary"
                        android:contentDescription="@string/desc_error_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/error_title"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/error_message"
                        android:textAlignment="center"
                        android:textColor="@color/text_subtle"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_retry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/btn_retry"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/sunset_primary"
                        app:cornerRadius="20dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
